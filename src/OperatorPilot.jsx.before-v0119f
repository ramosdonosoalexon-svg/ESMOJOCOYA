           <label>Cliente<input value={line.customer} onChange={e=>patchAllocation(i,{customer:e.target.value})}/></label>
           <label>Factura / vale<input value={line.reference} onChange={e=>patchAllocation(i,{reference:e.target.value})}/></label>
           <label>Litros / m³<input type="number" inputMode="decimal" step="any" min="0" value={line.volume} onChange={e=>patchAllocation(i,{volume:e.target.value})}/></label>
           {['prepago','postpago'].includes(line.concept)&&<button type="button" className="primary" onClick={()=>{setScanIndex(i);setError('');}}>▣ Escanear QR</button>}
           {line.invoiceCuf&&<small className="pilot-qr-info">QR: {line.invoiceNumber} · {line.invoiceNit} · CUF {line.invoiceCuf.slice(0,10)}…</small>}
           <button className="secondary" onClick={()=>patchEntry({allocations:entry.allocations.filter((_,j)=>j!==i)})}>Quitar</button>
         </div>)}
       </>}
       {entry.kind==='turno'&&step==='caja'&&<>
         <h3>Caja</h3>
         <div className="pilot-fields">{[['qr','Cobros QR (Bs)'],['card','Tarjeta (Bs)'],['cash','Efectivo contado (Bs)'],['deposit','Depósitos documentados (Bs)']].map(([key,label])=><label key={key}>{label}<input inputMode="decimal" type="number" min="0" step="0.01" value={entry.payments[key]} onChange={e=>patchEntry({payments:{...entry.payments,[key]:e.target.value}})}/></label>)}</div>
         <div className="pilot-settlement"><span>Ventas Bs {money(settlement.totalSales)}</span><span>Vales/descuentos Bs {money(settlement.otherValue)}</span><span>Efectivo esperado Bs {money(settlement.expectedCash)}</span><b>Diferencia de caja Bs {money(settlement.difference)}</b></div>
         {settlement.warnings.length>0&&<details className="pilot-guidance"><summary>{settlement.warnings.length} aviso(s) para revisar</summary>{settlement.warnings.join(' · ')}</details>}
       </>}
       <label>Nota (opcional)<textarea rows={2} maxLength={500} value={entry.note} onChange={e=>patchEntry({note:e.target.value})}/></label>
       <div className="pilot-actions pilot-save"><button className="secondary" disabled={busy} onClick={()=>persist(false)}>Guardar</button><button className="primary" disabled={busy||!entry.readings.length} onClick={()=>persist(true)}>{busy?'Guardando...':'Cerrar y enviar'}</button><button className="secondary" disabled={busy} onClick={()=>setEntry(null)}>Salir</button></div>
     </div>}
     <h3>{canManage?'Arqueos de prueba de la estación':'Historial'}</h3>
     {combined.length===0?<p className="muted">Todavía no hay arqueos de prueba.</p>:<div className="pilot-list">{combined.map(x=><div key={x.id} className="pilot-item">
       <div><b>{x.kind==='medianoche'?'00:00':'Turno'} · {x.date}</b><p>{canManage?x.operatorName+' · ':''}{x.readings?.length||0} mangueras · {x.status==='enviado'?'Enviado':'Borrador'} · {x.syncState==='pendiente'?'Pendiente':'En nube'}</p>{x.reviewStatus&&<span>Revisión: {x.reviewStatus}</span>}</div>
       <div className="pilot-actions"><button className="secondary" onClick={()=>{setToPrint({...x,printToken:Date.now()});setNotice('Abriendo vista de impresión. También puedes elegir Guardar como PDF.');}}>Imprimir / PDF</button>
         {isOperator&&enabled&&x.status==='borrador'&&<button className="secondary" onClick={()=>{setEntry(x);setError('');}}>Continuar</button>}
         {canManage&&x.status==='enviado'&&<><button disabled={busy} onClick={()=>markReview(x,'revisado')}>Revisado</button><button disabled={busy} onClick={()=>markReview(x,'observado')}>Observar</button></>}
       </div>
     </div>)}</div>}
     {canManage&&<div className="pilot-banner">Control de medianoche: {new Set(shared.filter(e=>e.phase==='medianoche'&&e.day===clockDate()).map(e=>e.hoseId)).size} / {sortedHoses.length} mangueras habilitadas con lecturas recibidas hoy. Los registros pendientes offline aparecerán al sincronizar.</div>}
     {canManage&&<label>Observación de revisión<input maxLength={500} value={reviewNote} onChange={e=>setReviewNote(e.target.value)} placeholder="Comentarios antes de observar un arqueo"/></label>}
     {isOperator&&<details className="pilot-compare-details"><summary>Estado de mangueras</summary>
       <div className="pilot-readings">{sortedHoses.map(h=>{const checked=shared.filter(e=>e.hoseId===h.id&&e.meterType===(h.meterTypes?.includes('digital')?'digital':'mecanico'));
         const results=compareAdjacentReadings(checked,h.id);
         const own=checked.filter(e=>e.operatorUid===uid&&['inicio','final'].includes(e.phase)).sort((a,b)=>String(a.observedAt).localeCompare(String(b.observedAt))).at(-1);
         const found=results.filter(x=>x.incoming===own?.id||x.outgoing===own?.id).at(-1);
         return <div key={h.id}><b>{h.name}</b><span className={`pilot-flag pilot-${found?.status||'off'}`}>{found?.status==='conciliado'?'Meter conciliado':found?.status==='diferencia'?`Diferencia ${fmt(found.difference)}`:'Pendiente de comparación'}</span></div>})}</div>
     </details>}
   </div>
   {scanIndex!==null&&<OperatorQRScanner onResult={scannedInvoice} onClose={()=>setScanIndex(null)}/>}
   {toPrint&&<PilotPrint entry={toPrint} stationName={stationName}/>}
 </section>;
}
