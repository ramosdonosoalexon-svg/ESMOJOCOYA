.pilot-root{display:grid;gap:18px}.pilot-root h3{margin:14px 0 8px}.pilot-between{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.pilot-between span{color:#64748b;font-size:.83rem}.pilot-flag{display:inline-block;border-radius:999px;font-size:.8rem;font-weight:700;padding:5px 9px;background:#e2e8f0;color:#475569}.pilot-on,.pilot-conciliado{background:#daf8e9;color:#176243}.pilot-diferencia{background:#ffe2de;color:#a42d26}.pilot-banner{background:#f5f7fb;border:1px solid #dce3ed;border-radius:10px;padding:12px;font-size:.9rem}.pilot-manager-switch,.pilot-item{padding:14px;border:1px solid #dce4eb;border-radius:12px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}.pilot-manager-switch p,.pilot-item p{margin:4px 0 0;font-size:.87rem;color:#64748b}.pilot-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.pilot-actions button,.pilot-add-hose select{min-height:40px}.pilot-editor{border:1px solid #c4d3de;background:#fbfdff;border-radius:14px;padding:15px;display:grid;gap:12px}.pilot-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(175px,1fr));gap:12px}.pilot-editor label{display:grid;gap:5px;color:#24384b;font-size:.85rem;font-weight:600}.pilot-editor input,.pilot-editor select,.pilot-editor textarea{width:100%;min-width:0;padding:9px;border:1px solid #cbd5e1;border-radius:8px;font-size:1rem}.pilot-hose-card{border:1px solid #e2e8f0;border-radius:12px;padding:12px;background:white;display:grid;gap:10px}.pilot-hose-footer{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap}.pilot-small,.pilot-volume{font-size:.85rem;color:#475569}.pilot-add-hose{max-width:440px}.pilot-allocation{display:grid;grid-template-columns:repeat(auto-fit,minmax(142px,1fr));gap:8px;padding:10px;border:1px solid #ddd;border-radius:10px;background:#fff}.pilot-guidance{padding:10px 12px;border-left:3px solid #e6a33e;background:#fff8eb;color:#674c15;font-size:.88rem}.pilot-midnight{background:#fce4ad;border-radius:10px;padding:10px}.pilot-settlement{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:6px;background:#eaf4f4;padding:12px;border-radius:12px;font-size:.9rem}.pilot-list{display:grid;gap:8px}.pilot-readings{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:8px}.pilot-readings>div{display:flex;justify-content:space-between;align-items:center;border:1px solid #ddd;border-radius:9px;padding:10px;gap:8px}.pilot-print-doc{display:none}
@media(max-width:640px){.pilot-editor{padding:10px}.pilot-fields{grid-template-columns:repeat(2,minmax(0,1fr))}.pilot-actions button{flex:1 0 auto}.pilot-manager-switch{align-items:stretch}}
@media print{body *{visibility:hidden!important}.pilot-root{padding:0!important;border:0!important}.pilot-print-doc,.pilot-print-doc *{visibility:visible!important}.pilot-print-doc{display:block!important;position:absolute;top:0;left:0;right:0;width:100%;padding:10mm!important;background:white;color:black;font-family:Arial,sans-serif;font-size:10pt}.pilot-print-doc h1{font-size:16pt;margin:0}.pilot-print-head{display:flex;align-items:center;justify-content:space-between;gap:8px;border-bottom:2px solid #000;margin-bottom:12px}.pilot-print-head strong{font-size:9pt}.pilot-print-doc table{width:100%;border-collapse:collapse;margin:10px 0}.pilot-print-doc th,.pilot-print-doc td{border:1px solid #333;padding:5px;text-align:left}.pilot-print-doc h3{margin:10px 0 4px;font-size:11pt}.pilot-print-doc p{margin:7px 0}.pilot-print-doc small{display:block;margin-top:10px} @page{size:A4;margin:12mm}}
