 }catch(err){setError(err.message||'No se pudo guardar el puente.')}finally{setBusy(false)}};
 const used=saved?.readings;
 const dispenserTotal=sumDay(shifts,date,'GNV').grossVolume;
 return <section className="meter-bridge">
   <div className="meter-bridge-title"><div><h3>1. Puente de regulación · GNV</h3><p>Los tres contadores de la matriz son independientes. Para el no corregido se muestra además la equivalencia K = J × 28,31701636; confirma las unidades del equipo antes del cierre oficial.</p></div><strong>m³</strong></div>
   {!complete&&!saved&&<p className="alert error">Faltan los datos iniciales del puente. Abre <b>Datos iniciales → Puente de regulación GNV</b> y registra sus tres lecturas.</p>}
   <form onSubmit={save}><div className="meter-bridge-scroller"><table className="meter-bridge-table"><thead><tr><th>Componente</th><th>Lectura inicial</th><th>Lectura final</th><th>Diferencia del medidor</th><th>Equivalencia matriz (m³)</th></tr></thead><tbody>
     {GNV_BRIDGE_CHANNELS.map(ch=>{const rec=used?.[ch.key];const initial=rec?.initial??openings[ch.key];const final=rec?.final??finals[ch.key];const volume=rec?.volume??(final!==''&&initial!==null&&Number(final)>=Number(initial)?roundBridge(Number(final)-Number(initial)):null);
